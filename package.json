{
  "name": "@gabewillen/self",
  "version": "0.1.0",
  "description": "Living MDScript self skills pack (agents load, run, and update continuously)",
  "license": "MIT",
  "type": "module",
  "private": false,
  "author": "Gabe Willen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabewillen/self.git"
  },
  "homepage": "https://github.com/gabewillen/self#readme",
  "bugs": {
    "url": "https://github.com/gabewillen/self/issues"
  },
  "keywords": [
    "agent-skills",
    "agentskills",
    "ai-agent-skill",
    "mdscript",
    "self",
    "skills"
  ],
  "files": [
    "skills",
    "scripts",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "self-agents": "./scripts/install.mjs"
  },
  "scripts": {
    "postinstall": "node ./scripts/install.mjs --live",
    "install-skills": "node ./scripts/install.mjs --live",
    "install-skills:live": "node ./scripts/install.mjs --live",
    "install-skills:copy": "node ./scripts/install.mjs --copy",
    "install-skills:pull": "node ./scripts/install.mjs --live --pull",
    "install-skills:no-adapters": "node ./scripts/install.mjs --live --no-adapters",
    "pack:check": "npm pack --dry-run",
    "test": "node scripts/typecheck-hooks.mjs && node scripts/validate-mdscript.mjs && node scripts/test-agent-home.mjs && node scripts/test-self-review-install.mjs && node scripts/test-self-implement-install.mjs && node scripts/test-gabe-to-self-cutover.mjs && node scripts/test-hook-session-scope.mjs && node scripts/test-script-integrity.mjs && node scripts/test-install-symlink.mjs && node scripts/test-live-branch-safety.mjs && node scripts/test-router-directive.mjs && node scripts/test-goal-signoff-gate.mjs",
    "validate": "node scripts/validate-mdscript.mjs",
    "test:install-review": "node scripts/test-self-review-install.mjs",
    "test:install-implement": "node scripts/test-self-implement-install.mjs",
    "test:cutover": "node scripts/test-gabe-to-self-cutover.mjs",
    "test:install-symlink": "node scripts/test-install-symlink.mjs",
    "test:live-branch": "node scripts/test-live-branch-safety.mjs",
    "test:router-directive": "node scripts/test-router-directive.mjs",
    "test:signoff-gate": "node scripts/test-goal-signoff-gate.mjs",
    "typecheck": "node scripts/typecheck-hooks.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "agents": {
    "skills": [
      {
        "name": "self",
        "path": "./skills/self"
      },
      {
        "name": "self-automate",
        "path": "./skills/self-automate"
      },
      {
        "name": "self-goal",
        "path": "./skills/self-goal"
      },
      {
        "name": "self-implement",
        "path": "./skills/self-implement"
      },
      {
        "name": "self-learn",
        "path": "./skills/self-learn"
      },
      {
        "name": "self-orchestrate",
        "path": "./skills/self-orchestrate"
      },
      {
        "name": "self-review",
        "path": "./skills/self-review"
      },
      {
        "name": "self-unwatch",
        "path": "./skills/self-unwatch"
      },
      {
        "name": "self-watch",
        "path": "./skills/self-watch"
      }
    ]
  },
  "agentskills": {
    "skills": [
      {
        "name": "self",
        "path": "./skills/self"
      },
      {
        "name": "self-automate",
        "path": "./skills/self-automate"
      },
      {
        "name": "self-goal",
        "path": "./skills/self-goal"
      },
      {
        "name": "self-implement",
        "path": "./skills/self-implement"
      },
      {
        "name": "self-learn",
        "path": "./skills/self-learn"
      },
      {
        "name": "self-orchestrate",
        "path": "./skills/self-orchestrate"
      },
      {
        "name": "self-review",
        "path": "./skills/self-review"
      },
      {
        "name": "self-unwatch",
        "path": "./skills/self-unwatch"
      },
      {
        "name": "self-watch",
        "path": "./skills/self-watch"
      }
    ]
  },
  "aiAgentSkill": [
    "skills/self-automate/SKILL.md",
    "skills/self-goal/SKILL.md",
    "skills/self-implement/SKILL.md",
    "skills/self-orchestrate/SKILL.md",
    "skills/self-review/SKILL.md",
    "skills/self-unwatch/SKILL.md",
    "skills/self-watch/SKILL.md",
    "skills/self/SKILL.md"
  ],
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}
