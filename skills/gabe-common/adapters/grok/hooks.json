{
  "version": 1,
  "adapter": "grok",
  "skill": "gabe-common",
  "target": "grok-hooks",
  "runtime": "bun",
  "runtimeFallbacks": ["bun", "node"],
  "hooks": {
    "Stop": [
      {
        "id": "gabe-learn-stop",
        "script": "../../hooks/learn-stop.ts",
        "timeout": 120
      }
    ]
  },
  "replaceLegacyCommands": [
    "skills/gabe-learn/",
    "skills/gabe-common/hooks/learn-stop.ts"
  ]
}
