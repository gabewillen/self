{
  "version": 1,
  "adapter": "claude",
  "skill": "gabe-goal",
  "target": "claude-settings",
  "runtime": "bun",
  "runtimeFallbacks": [
    "bun",
    "node"
  ],
  "hooks": {
    "SessionStart": [
      {
        "id": "gabe-goal-session-start",
        "script": "../../hooks/goal-session-start.ts"
      }
    ],
    "UserPromptSubmit": [
      {
        "id": "gabe-goal-session-touch",
        "script": "../../hooks/goal-session-touch.ts"
      }
    ],
    "Stop": [
      {
        "id": "gabe-goal-stop",
        "script": "../../hooks/goal-stop.ts",
        "timeout": 600
      }
    ]
  },
  "replaceLegacyCommands": [
    "skills/goal/scripts/goal-session-start.ts",
    "skills/goal/scripts/goal-session-touch.ts",
    "skills/goal/scripts/goal-stop.ts",
    "skills/gabe-goal/scripts/cursor-hooks/",
    "skills/gabe-goal/adapters/cursor/"
  ]
}
