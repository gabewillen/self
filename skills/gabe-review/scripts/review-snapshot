#!/usr/bin/env bash
set -euo pipefail

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "review-snapshot: not inside a Git worktree" >&2
  exit 2
fi

index_path="$(git rev-parse --git-path index 2>/dev/null || true)"
tmp_index="$(mktemp -t gabe-review-snapshot.XXXXXX 2>/dev/null || mktemp)"
trap 'rm -f "$tmp_index"' EXIT

if [[ -n "$index_path" && -f "$index_path" ]]; then
  cp "$index_path" "$tmp_index"
else
  rm -f "$tmp_index"
fi

if [[ -f "$tmp_index" ]]; then
  if ! GIT_INDEX_FILE="$tmp_index" git ls-files -z \
    | GIT_INDEX_FILE="$tmp_index" git update-index --no-assume-unchanged -z --stdin >/dev/null 2>&1; then
    echo "review-snapshot: failed to clear temporary assume-unchanged flags" >&2
    exit 1
  fi
fi

tree=""
if ! GIT_INDEX_FILE="$tmp_index" git add -A >/dev/null 2>&1; then
  echo "review-snapshot: failed to populate temporary index" >&2
  exit 1
fi

if ! tree="$(GIT_INDEX_FILE="$tmp_index" git write-tree 2>/dev/null)" || [[ -z "$tree" ]]; then
  echo "review-snapshot: failed to write snapshot tree" >&2
  exit 1
fi

printf '%s\n' "$tree"
