{
  "version": 1,
  "adapter": "cursor",
  "skill": "self-common",
  "runtime": "bun",
  "runtimeFallbacks": [
    "bun",
    "node"
  ],
  "hooks": {
    "stop": [
      {
        "id": "self-learn-stop",
        "script": "../../hooks/learn-stop.ts",
        "timeout": 120
      }
    ],
    "beforeSubmitPrompt": [
      {
        "id": "self-learn-session-touch",
        "script": "../../hooks/learn-session-touch.ts"
      }
    ]
  },
  "replaceLegacyCommands": [
    "skills/self-learn/",
    "skills/self-common/hooks/learn-stop.ts",
    "skills/gabe-learn/",
    "skills/gabe-common/hooks/learn-stop.ts",
    "skills/gabe-common/",
    "skills/gabe-common/hooks/",
    "skills/self-common/hooks/"
  ]
}
