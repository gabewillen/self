{
  "version": 1,
  "adapter": "claude",
  "skill": "self-common",
  "target": "claude-settings",
  "runtime": "bun",
  "runtimeFallbacks": [
    "bun",
    "node"
  ],
  "hooks": {
    "Stop": [],
    "UserPromptSubmit": []
  },
  "replaceLegacyCommands": [
    "skills/self-learn/",
    "skills/self-common/hooks/learn-stop.ts",
    "skills/self-common/hooks/learn-session-touch.ts",
    "skills/gabe-learn/",
    "skills/gabe-common/hooks/learn-stop.ts",
    "skills/gabe-common/",
    "skills/gabe-common/hooks/",
    "skills/self-common/hooks/"
  ],
  "note": "self-common ships no harness hooks. Learn is user-invoked via the /self-learn skill. These empty event lists stay so install scrubs previously installed self-learn Stop/prompt hooks from this harness config."
}
